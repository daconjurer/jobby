# Host configuration: tasks, tests and debugging on the host (copy to .env).
# Containers load this file too, then docker/app.env on top, which overrides the
# address-bearing values (MONGODB_URI, PULSAR_SERVICE_URL, JOB_TOPICS_CONFIG_PATH,
# DISPATCH_STREAM_MONGODB_RESUME_TOKEN_PATH) with their in-network equivalents.

# Jobs HTTP API (cmd/jobs-server)
APP_PORT=3001

# MongoDB Configuration (Single Database: jobby)
# Host binary / integration tests — Mongo published on localhost:27018.
# Local Compose runs a single-node replica set rs0 (required for change streams). The member is
# advertised as mongodb:27017 inside Docker; from the host use localhost:27018 with replicaSet=rs0
# and directConnection=true so the driver does not follow that internal hostname.
MONGODB_URI=mongodb://jobby_app:jobby_app_pass@localhost:27018/jobby?authSource=jobby&replicaSet=rs0&directConnection=true
MONGODB_DATABASE=jobby
MONGODB_TIMEOUT=10s

# Collection Names (within jobby database)
MONGODB_COLLECTION_METADATA=job_metadata
MONGODB_COLLECTION_LOGS=job_logs

# Connection Pool Settings (Optional)
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# Job name → topic YAML manifest (jobs-server enqueue; default: config/job-topics.yaml)
JOB_TOPICS_CONFIG_PATH=config/job-topics.yaml

# Dispatch worker (cmd/jobs-dispatcher) — change stream + poll → Pulsar
PULSAR_SERVICE_URL=pulsar://localhost:6650
# Subscription name reserved for executor consumers (default: jobber)
PULSAR_SUBSCRIPTION_NAME=jobber
DISPATCH_POLL_INTERVAL=5s
DISPATCH_POLL_BATCH_SIZE=50
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_STREAM_MAX_POOL_SIZE=2
# Optional; empty disables MongoDB change stream resume token persistence
DISPATCH_STREAM_MONGODB_RESUME_TOKEN_PATH=

# E2E tests (internal/jobs/executor/e2e_integration_test.go)
# HTTP API base URL for E2E tests (defaults to http://localhost:3001 if unset)
JOBS_API_BASE_URL=http://localhost:3001
